{
    "name": "mi-poultry/cms",
    "type": "project",
    "description": "MI Automatic Poultry Cages — Bilingual CMS built on Laravel 12 + Filament 3.",
    "keywords": ["laravel", "filament", "cms", "poultry", "mi"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^3.2",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/spatie-laravel-tags-plugin": "^3.2",
        "filament/spatie-laravel-translatable-plugin": "^3.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10",
        "livewire/livewire": "^3.5",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-google-fonts": "^1.4",
        "spatie/laravel-honeypot": "^4.5",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.4",
        "spatie/laravel-settings": "^3.3",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/laravel-sluggable": "^3.6",
        "spatie/laravel-tags": "^4.6",
        "spatie/laravel-translatable": "^6.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "barryvdh/laravel-debugbar": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "fresh": [
            "@php artisan migrate:fresh --seed",
            "@php artisan optimize:clear"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

APP_NAME="MI Poultry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

# Available locales (comma-separated) — used by SetLocale middleware
APP_AVAILABLE_LOCALES=ar,en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ----- Database -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mi_poultry
DB_USERNAME=root
DB_PASSWORD=

# For local quick start:
# DB_CONNECTION=sqlite

# ----- Cache / Queue / Session -----
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ----- Mail -----
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@mi-poultry.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----- MI Business -----
MI_PHONE_PRIMARY="+201030003186"
MI_PHONE_SUPPORT="+201030003186"
MI_WHATSAPP="201030003186"
MI_EMAIL="info@mi-poultry.com"
MI_ADDRESS_AR="دمياط · مصر"
MI_ADDRESS_EN="Damietta · Egypt"

# Contact form recipient
MI_CONTACT_INBOX="sales@mi-poultry.com"

# ----- Calculator default unit prices (EGP) -----
# (can also be edited live from Filament admin → Settings)
CALC_CONCRETE_M2=2800
CALC_STEEL_M2=4200
CALC_WALLS_M2=2400
CALC_TANKS_FIXED=95000
CALC_BIRD_COST=220
CALC_REAR_FAN=42000
CALC_COOLING_FACTOR=5500
CALC_WINDOW=4800
CALC_SIDE_FAN=35000
CALC_HEATER=26000
CALC_CONTROL_FIXED=110000

VITE_APP_NAME="${APP_NAME}"
